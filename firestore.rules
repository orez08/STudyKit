rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default-deny all documents
    match /{document=**} {
      allow read, write: if false;
    }

    // Connection testing
    match /test/connection {
      allow read: if true;
    }

    // User profile document
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      // Subcollection: private uploaded documents
      match /documents/{docId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // Subcollection: private generated summaries
      match /summaries/{summaryId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // Subcollection: private generated quizzes
      match /quizzes/{quizId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // Subcollection: private flashcard decks
      match /flashcards/{deckId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // Subcollection: private planner tasks
      match /plannerTasks/{taskId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // Subcollection: private practice tests
      match /practiceTests/{testId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // Subcollection: chat messages
      match /chatHistory/{msgId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    match /publicStats/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
